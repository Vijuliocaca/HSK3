{
  "permissions": {
    "allow": [
      "Bash(node tests/*)",
      "Bash(TODAS=1 node tests/*)",
      "Bash(node tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q \"git commit\" || exit 0; node tests/run.js > /dev/null 2>&1 || { echo \"node tests/run.js falla: arréglalo antes del commit\" >&2; exit 2; }",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
